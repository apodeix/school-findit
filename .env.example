# Firebase console > Project settings > General > Your apps > Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# The part after @ in the school's Google Workspace email address.
NEXT_PUBLIC_SCHOOL_EMAIL_DOMAIN=

# Server only: Vercel Production sensitive environment variable. Never NEXT_PUBLIC.
# Provision with scripts/connect-server.mjs; never paste the private key in chat/Git.
FIREBASE_SERVICE_ACCOUNT=
