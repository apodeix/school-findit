rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function securitySettingsExist() {
      return exists(/databases/$(database)/documents/app_settings/security);
    }

    function isSchoolUser() {
      return signedIn()
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && securitySettingsExist()
        && (
          request.auth.token.email.matches(
            get(/databases/$(database)/documents/app_settings/security).data.allowedEmailPattern
          )
          // 학교 도메인을 확정하기 전 여러 역할을 시험하기 위한 임시 허용이다.
          || request.auth.token.email.matches('.*@gmail[.]com')
        );
    }

    function isInitialAdmin() {
      return isSchoolUser()
        && get(/databases/$(database)/documents/app_settings/security).data.initialAdminEmail
          == request.auth.token.email;
    }

    function isTeacher() {
      return isSchoolUser()
        && (
          (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
              in ['teacher', 'final_admin']
          )
          || (
            exists(/databases/$(database)/documents/teacher_verifications/$(request.auth.uid))
            && get(/databases/$(database)/documents/teacher_verifications/$(request.auth.uid)).data.active == true
          )
        );
    }

    function isFinalAdmin() {
      return isSchoolUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          == 'final_admin';
    }

    match /app_settings/{document} {
      allow read, create, delete: if false;
      allow update: if document == 'security'
        && isFinalAdmin()
        && request.resource.data.teacherCodeHash is string
        && request.resource.data.teacherCodeHash.matches('[0-9a-f]{64}')
        && request.resource.data.teacherCodeUpdatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'teacherCodeHash', 'teacherCodeUpdatedAt', 'teacherCodeUpdatedBy'
        ]);
    }

    match /teacher_verifications/{userId} {
      allow read: if isSchoolUser() && request.auth.uid == userId;
      allow create: if isSchoolUser()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'userId', 'codeHash', 'active', 'verifiedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.active == true
        && request.resource.data.codeHash is string
        && request.resource.data.codeHash.matches('[0-9a-f]{64}')
        && request.resource.data.codeHash
          == get(/databases/$(database)/documents/app_settings/security).data.teacherCodeHash;
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if isSchoolUser() && request.auth.uid == userId;
      allow create: if isSchoolUser()
        && request.auth.uid == userId
        && request.resource.data.active == true
        && request.resource.data.email == request.auth.token.email
        && (
          (isInitialAdmin() && request.resource.data.role == "final_admin")
          || (!isInitialAdmin() && request.resource.data.role == "student")
        );
      allow update, delete: if false;
    }

    match /items/{itemId} {
      allow read: if isSchoolUser()
        && (
          resource.data.isPublished == true
          || resource.data.authorId == request.auth.uid
          || isTeacher()
        );
      allow create: if isSchoolUser()
        && request.resource.data.authorId == request.auth.uid
        && (
          request.resource.data.imageDataUrl == null
          || (
            request.resource.data.imageDataUrl is string
            && request.resource.data.imageDataUrl.size() <= 450000
            && request.resource.data.imageDataUrl.matches('data:image/jpeg;base64,.*')
          )
        )
        && (
          (request.resource.data.kind == "lost"
            && request.resource.data.status == "seeking"
            && request.resource.data.isPublished == true)
          ||
          (request.resource.data.kind == "found"
            && request.resource.data.status == "pending_handoff"
            && request.resource.data.isPublished == false)
        );
      allow update: if (
          isSchoolUser()
          && resource.data.authorId == request.auth.uid
          && resource.data.status in ['seeking', 'pending_handoff']
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.location is string
          && request.resource.data.location.size() >= 2
          && request.resource.data.dateText is string
          && request.resource.data.dateText.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'title', 'location', 'dateText', 'description', 'updatedAt'
          ])
        ) || (
          isTeacher()
          && resource.data.kind == 'found'
          && resource.data.status == 'pending_handoff'
          && request.resource.data.status == 'teacher_received'
          && request.resource.data.isPublished == true
          && request.resource.data.storageLocation is string
          && request.resource.data.storageLocation.size() >= 2
          && request.resource.data.receivedById == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'isPublished', 'storageLocation', 'receivedById',
            'receivedAt', 'updatedAt'
          ])
        ) || (
          isSchoolUser()
          && (resource.data.authorId == request.auth.uid || isFinalAdmin())
          && request.resource.data.deleted == true
          && request.resource.data.isPublished == false
          && request.resource.data.deletedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'deleted', 'isPublished', 'deletedBy', 'deletedAt', 'updatedAt'
          ])
        );
      allow delete: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isSchoolUser()
        && (resource.data.userId == request.auth.uid || isFinalAdmin());
      allow create: if isTeacher()
        && request.resource.data.keys().hasOnly([
          'userId', 'type', 'title', 'message', 'itemId', 'read', 'status',
          'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.type == 'found_item_received'
        && request.resource.data.itemId is string
        && request.resource.data.userId
          == get(/databases/$(database)/documents/items/$(request.resource.data.itemId)).data.authorId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.read == false
        && request.resource.data.status == 'active';
      allow update: if (
          isSchoolUser()
          && resource.data.userId == request.auth.uid
          && request.resource.data.read == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'read', 'updatedAt'
          ])
        ) || (
          isFinalAdmin()
          && resource.data.status == 'active'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'cancelledBy', 'cancelledAt', 'updatedAt'
          ])
        );
      allow delete: if false;
    }

    // 도움 포인트 지급과 취소는 향후 서버 또는 Cloud Function에서만 처리한다.
    match /reward_transactions/{transactionId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
